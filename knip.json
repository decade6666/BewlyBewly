{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/contentScripts/index.ts",
    "src/background/index.ts",
    "src/options/main.ts",
    "src/popup/main.ts",
    "src/components/**",
    "scripts/*.ts",
    "*.config.*"
  ],
  "ignore": [
    "src/inject/**",
    ".trellis/**",
    "src/composables/useFilter.ts",
    "src/logic/common-setup.ts",
    "src/utils/svgIcons.ts",
    "src/contentScripts/views/necessarySettingsWatchers.ts",
    "src/contentScripts/views/Anime/**",
    "src/contentScripts/views/Home/Home.vue",
    "src/contentScripts/views/Home/components/**",
    "src/contentScripts/views/Favorites/**",
    "src/contentScripts/views/History/**",
    "src/contentScripts/views/Moments/**",
    "src/contentScripts/views/Search/**",
    "src/contentScripts/views/WatchLater/**",
    "src/models/anime/**",
    "src/models/live/getFollowingLiveList.ts",
    "src/models/moment/moment.ts",
    "src/models/video/favorite.ts",
    "src/models/video/favoriteCategory.ts",
    "src/models/video/forYou.ts",
    "src/models/video/historySearch.ts",
    "src/models/video/ranking.ts",
    "src/models/video/rankingPgc.ts",
    "src/models/video/trending.ts"
  ],
  "ignoreDependencies": [
    "@iconify/json",
    "uno.css",
    "lint-staged"
  ],
  "ignoreBinaries": ["gh", "xcrun"],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
